# Copy this file to `.env` in the repo root and replace placeholder values.
# The dashboard runs without `.env` using bundled demo data; optional features
# stay disabled until you configure the variables below.

# --- AI auto-categorization (optional) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BATCH_SIZE=20
# GEMINI_REQUEST_TIMEOUT_S=60

# --- Email reports (optional) ---
# Gmail app password: https://support.google.com/accounts/answer/185833
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
REPORT_EMAIL_TO=recipient@gmail.com

# --- Server (optional) ---
# MONEY_TRACKER_HOST=127.0.0.1
# MONEY_TRACKER_PORT=8050
# MONEY_TRACKER_DEBUG=0

# --- Custom data directories (optional) ---
# MONEY_TRACKER_DATA_DIR=/path/to/config/root
# MONEY_TRACKER_CSV_DIR=/path/to/csv_files
